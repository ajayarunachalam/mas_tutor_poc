# MAS Education POC — Environment Variables Template
# Copy this to .env and fill in your values

# === LLM Keys ===
ANTHROPIC_API_KEY=sk-ant-...  # Required: get from https://console.anthropic.com/

# === LLM Config ===
LLM_PRIMARY=claude-sonnet-4-6
LLM_FALLBACK=mistral:latest   # Local Ollama model (free)

# === LLM Gateway / Observability ===
# "direct" (default): AsyncAnthropic or OpenRouterClient, unchanged behavior.
# "litellm": routes every call through LiteLLM + auto-traces it in MLflow.
LLM_GATEWAY=direct
MLFLOW_TRACKING_URI=file:./mlruns   # local file store — no server process needed
MLFLOW_EXPERIMENT_NAME=mas-tutor
OLLAMA_HOST=http://localhost:11434  # used by LiteLLM for ollama_chat/* models

# === RAG / ChromaDB ===
CHROMA_PATH=/home/tonyts/.pai/rag/chromadb
CHROMA_COLLECTION=poc_curriculum
RAG_RELEVANCE_THRESHOLD=0.15  # Minimum term-overlap rerank score; chunks below this are filtered out

# === Agent Ports (one per agent) ===
TUTOR_PORT=8001
ASSESSMENT_PORT=8002
PLANNING_PORT=8003
DIALOGUE_PORT=8004
MONITOR_PORT=8005
ORCHESTRATOR_PORT=8000

# === SQLite ===
DB_PATH=./mas_poc.db

# === Thresholds (from architecture) ===
MASTERY_THRESHOLD=0.85
ENGAGEMENT_STUCK_THRESHOLD=3
DIALOGUE_MIN_WORDS=5
